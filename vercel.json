{
  "version": 2,
  "buildCommand": "pnpm --filter @workspace/y-chang run build",
  "outputDirectory": "artifacts/y-chang/dist/public",
  "framework": "vite",
  "redirects": [
    {
      "source": "/dich-vu/phun-may-sandbrows",
      "destination": "/dich-vu/amazingbrows-for-men",
      "permanent": true
    },
    {
      "source": "/dich-vu/phun-xam",
      "destination": "/dich-vu#phun-xam",
      "permanent": false
    },
    {
      "source": "/dich-vu/spa",
      "destination": "/dich-vu#spa",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/api/sitemap.xml" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
