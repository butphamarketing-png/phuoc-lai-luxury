# =============================================================================
# VERCEL — thêm các biến này trong Vercel Dashboard → Settings → Environment Variables
# Sau đó bấm Redeploy (bắt buộc vì Vite embed env lúc build)
# =============================================================================
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_SITE_URL=https://phunxamvungtau.com

# =============================================================================
# SUPABASE — tạo project tại https://supabase.com
# Chạy SQL: supabase/setup.sql trong SQL Editor (xem supabase/README.md)
# =============================================================================
# Settings → API
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Settings → Database (chỉ cần nếu chạy API server / Drizzle sau này)
# DATABASE_URL=postgresql://postgres.[ref]:[password]@...pooler.supabase.com:6543/postgres

# =============================================================================
# Local dev (copy thành file .env ở thư mục gốc repo)
# =============================================================================
PORT=3000
BASE_PATH=/
